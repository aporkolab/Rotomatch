{
  "name": "rotomatch",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:prod": "sirv dist/matching-game-angular --single --host 0.0.0.0",
    "build": "ng build --configuration=production",
    "build:dev": "ng build --configuration=development",
    "build:analyze": "ng build --configuration=production --stats-json && npx webpack-bundle-analyzer dist/matching-game-angular/stats.json",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "test:coverage": "ng test --coverage",
    "e2e": "ng e2e",
    "lint": "eslint . --ext .ts,.html",
    "lint:fix": "eslint . --ext .ts,.html --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\"",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "audit:security": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "clean": "node -e \"for (const d of ['dist', 'node_modules/.cache']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "deploy": "npm run build && npm run start:prod",
    "version:patch": "npm version patch && git push --follow-tags",
    "version:minor": "npm version minor && git push --follow-tags",
    "version:major": "npm version major && git push --follow-tags"
  },
  "private": true,
  "homepage": "https://rotomatch.aporkolab.com",
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cli": "~22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "bootstrap": "^5.3.8",
    "font-awesome": "^4.7.0",
    "ngx-bootstrap": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3",
    "sirv-cli": "^3.0.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "~22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/language-service": "^22.2.4",
    "@angular/localize": "^22.2.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "webpack-bundle-analyzer": "^5.4.0"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "brace-expansion@^5.0.8": "5.0.12",
    "minimatch@^10": "^11.0.3"
  }
}
